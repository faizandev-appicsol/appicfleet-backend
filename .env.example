# Copy to .env. Never commit .env. Never put these values in the frontend.

# development | test | staging | production
NODE_ENV=development
APP_NAME=Appic Fleet API
PORT=4000

# MongoDB connection used by Mongoose.
# Atlas URLs use mongodb+srv://. A local server uses mongodb://.
# Development example:
MONGODB_URI=mongodb://127.0.0.1:27017/appicfleet
# Test example (use a dedicated database):
# MONGODB_URI=mongodb://127.0.0.1:27017/appicfleet_test
# Staging / production: use Atlas or a managed MongoDB URI with auth.

# Generate both with a password manager or:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Each secret must be at least 32 characters, and they must be different.
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins. Credentials require an explicit origin, not *.
CORS_ORIGIN=http://localhost:5173

# error | warn | info | debug
LOG_LEVEL=debug

# Optional. `npm run db:seed` creates an active admin only when both are set.
# The password is never printed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# File / image storage (all uploads: customer docs, HR docs, vehicle images, …)
# ---------------------------------------------------------------------------
# local = disk (STORAGE_DIR or backend/var/customer-documents)
# s3    = AWS S3 (requires the four AWS_* credentials below)
STORAGE_DRIVER=local
# STORAGE_DIR=

# AWS S3 — set STORAGE_DRIVER=s3 and fill these values manually
AWS_REGION=us-east-1
AWS_S3_BUCKET=letterly-backend-stg-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional object-key prefix inside the bucket
AWS_S3_PREFIX=fleet-uploads
